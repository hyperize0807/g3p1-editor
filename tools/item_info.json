{"1": {"eng": "Dagger", "cat": "무기", "desc": "일반적인 단검.", "ts": 10, "ss": 50}, "2": {"eng": "Assassin Dagger", "cat": "무기", "desc": "공격력이 약간높고 크리티컬률이 매우 높은 단검. (특정 조건 만족시 적 암살)", "ts": 12, "ss": 55}, "3": {"eng": "Stiletto", "cat": "무기", "desc": "방어력이 탁월한 단검", "ts": 13, "ss": 60}, "4": {"eng": "Virgin Sword", "cat": "무기", "desc": "처녀의 한이 담긴 은으로 만든 단검. (피격자 상태이상 초래)", "ts": 14, "ss": 65}, "5": {"eng": "Gradius", "cat": "무기", "desc": "최고의 단검. (피격자 회피 불능)", "ts": 15, "ss": 70}, "6": {"eng": "Rapier", "cat": "무기", "desc": "가장 일반적인 세검.", "ts": 20, "ss": 90}, "7": {"eng": "Sabre", "cat": "무기", "desc": "레이피어를 개량한 세검.", "ts": 22, "ss": 100}, "8": {"eng": "Estoc", "cat": "무기", "desc": "샤벨을 보다 강력하게 개량한 세검", "ts": 24, "ss": 110}, "9": {"eng": "Kasandra", "cat": "무기", "desc": "최면효과를 가진 세검.", "ts": 26, "ss": 130}, "10": {"eng": "Glass Sword", "cat": "무기", "desc": "가격대 성능비는 우수하지만 저주가 걸려있는 세검(AC-10/SPD-4)", "ts": 24, "ss": 150}, "11": {"eng": "Gramr", "cat": "무기", "desc": "최고의 세검으로 불려진다.", "ts": 28, "ss": 140}, "12": {"eng": "Silpheed", "cat": "무기", "desc": "전격속성의 세검.", "ts": 30, "ss": 170}, "13": {"eng": "Tranning Sword", "cat": "무기", "desc": "수련을 할때 사용되는 나무로된 장검.", "ts": 5, "ss": 20}, "14": {"eng": "Short Sword", "cat": "무기", "desc": "짧은 장검으로 크리티컬율이 높다.", "ts": 50, "ss": 40}, "15": {"eng": "Long Sword", "cat": "무기", "desc": "가장 일반적으로 쓰이는 장검.", "ts": 55, "ss": 50}, "16": {"eng": "Silver Sword", "cat": "무기", "desc": "은으로 만들어진 장검.", "ts": 60, "ss": 70}, "17": {"eng": "Dark Sword", "cat": "무기", "desc": "암흑속성의 장검.(피격자 혼란)", "ts": 70, "ss": 60}, "18": {"eng": "Chrysaor", "cat": "무기", "desc": "검의 명가 크리사오르에서 만든 장검으로 전체적으로 안정적인 능력을 가지고 있다.", "ts": 72, "ss": 70}, "19": {"eng": "Magician Sword", "cat": "무기", "desc": "마법을 사용할수 없는 검사들에게 애용되던 장검. (INT+10/화이어애로우/라이트닝볼트 사용가능)", "ts": 64, "ss": 40}, "20": {"eng": "Durendal", "cat": "무기", "desc": "몇몇 귀족 기사들이 사용하던 고급스러운 장검.", "ts": 88, "ss": 70}, "21": {"eng": "Blitz", "cat": "무기", "desc": "실전을 위해 만든 실용검. 가격은 싸나 성능은 듀렌달에 뒤지지 않는 장검.", "ts": 80, "ss": 90}, "22": {"eng": "Chrysaor SE", "cat": "무기", "desc": "검의 명가 크리사오르에서 만든 최고의 장검.", "ts": 85, "ss": 80}, "23": {"eng": "Flash Sword", "cat": "무기", "desc": "마법이 기록된 필름을 달아줌으로서 마법효과를 사용할 수 도있다. (장검/필름장착가능)", "ts": 55, "ss": 70}, "24": {"eng": "Meteor Sword", "cat": "무기", "desc": "때때로 검이 유성을 부르기도 한다.(장검/특정 조건시 메테오 사용)", "ts": 92, "ss": 85}, "25": {"eng": "Excalibur", "cat": "무기", "desc": "이올린의 애검이었던 전설의 성검. (장검/살 사용가능/블리자드 스탐 사용가능)", "ts": 95, "ss": 100}, "26": {"eng": "Barisada II", "cat": "무기", "desc": "팬드래건 왕가의 비검으로 마장기 아론다이트의 열쇠이기도 하다. (장검/설화난영참 사용가능)", "ts": 100, "ss": 90}, "27": {"eng": "Broad Sword", "cat": "무기", "desc": "검의 방어력과 내구력이 탁월한 대검.", "ts": 100, "ss": 30}, "28": {"eng": "Barstard Sword", "cat": "무기", "desc": "브로드소드의 약점이었던 공격력을 상승시킨 대검.", "ts": 110, "ss": 30}, "29": {"eng": "Great Sword", "cat": "무기", "desc": "안정된 능력을 가진 대검.", "ts": 120, "ss": 30}, "30": {"eng": "Claymore", "cat": "무기", "desc": "귀족들 사이에서 쓰이던 고급스러운 대검. 성능도 우수하다.", "ts": 130, "ss": 30}, "31": {"eng": "Armada", "cat": "무기", "desc": "클레이모어를 보급형으로 개조한 대검으로 가격대에 비해 만족스러운 성능을 지녔다.", "ts": 140, "ss": 33}, "32": {"eng": "Stardust", "cat": "무기", "desc": "최고의 내구력과 방어력을 자랑하는 대검. 하지만 공격력은 약하다.", "ts": 80, "ss": 30}, "33": {"eng": "Giga Death", "cat": "무기", "desc": "한때 제국 최고의 검사라 불리우던 칼스의 애검.(슈미터/천지파열무 사용가능)", "ts": 150, "ss": 35}, "34": {"eng": "Storm Blinger", "cat": "무기", "desc": "최고의 장검. 폭풍을 부르는 검이라고도 불린다. 대검(폭풍검 사용가능/특정 조건시 썬더스탐 사용)", "ts": 160, "ss": 40}, "35": {"eng": "Damascus", "cat": "무기", "desc": "칼의 모양이 구부러져있는 곡도. 주로 시반 슈미터들이 사용한다.", "ts": 40, "ss": 60}, "36": {"eng": "Zamad Agni", "cat": "무기", "desc": "적에게 치명상을 주게되면 부가효과를 나타내기도 하는 슈미터.(피격자 상태이상 유발)", "ts": 45, "ss": 70}, "37": {"eng": "Moon Sword", "cat": "무기", "desc": "전체적으로 우수한 성능을 가진 슈미터.", "ts": 50, "ss": 80}, "38": {"eng": "Britra", "cat": "무기", "desc": "적을 최면에 빠트리는 능력을 가지고 있는 슈미터.(피격자 최면)", "ts": 55, "ss": 90}, "39": {"eng": "Kabilaka", "cat": "무기", "desc": "칼끝에 묻은 독이 묻어있는 슈미터.(피격자 중독)", "ts": 60, "ss": 100}, "40": {"eng": "Amitayouth", "cat": "무기", "desc": "적의 이성을 빼앗아가 버리는 마검 슈미터.(피격자 버써크)", "ts": 65, "ss": 110}, "41": {"eng": "Hiral Halrode", "cat": "무기", "desc": "최강의 공격력을 자랑하는 슈미터. (피격자 상태이상/마룡광아탄 사용가능)", "ts": 75, "ss": 120}, "42": {"eng": "Yama", "cat": "무기", "desc": "투르의 최신 기술로 만들어낸 광선검. 예니치리들이 사용한다.", "ts": 100, "ss": 100}, "43": {"eng": "Sukra", "cat": "무기", "desc": "위력은 야마와 비슷하지만 가볍고 다루기가  쉽운 광선검.", "ts": 120, "ss": 120}, "44": {"eng": "Zihad", "cat": "무기", "desc": "스스로의 의지를 갖고 있는 최고의 광선검.(지하드 사용가능)", "ts": 140, "ss": 140}, "45": {"eng": "Hand Gun", "cat": "무기", "desc": "단발 권총. 위력은 그다지 기대할 수 없다.", "ts": 50, "ss": 40}, "46": {"eng": "Revolver", "cat": "무기", "desc": "핸드건의 강화한 권총.", "ts": 60, "ss": 50}, "47": {"eng": "Pistol", "cat": "무기", "desc": "공격력을 강화한 권총.", "ts": 70, "ss": 60}, "48": {"eng": "Kilu", "cat": "무기", "desc": "권총으로서는 만족할 만한 위력을 가지고 있다.", "ts": 90, "ss": 70}, "49": {"eng": "Nightmare", "cat": "무기", "desc": "적을 단 일격에 쓰러트린다는 권총.(암살기능)", "ts": 100, "ss": 80}, "50": {"eng": "Rifle", "cat": "무기", "desc": "가장 기본적인 라이플", "ts": 50, "ss": 40}, "51": {"eng": "Long Rifle", "cat": "무기", "desc": "라이플을 개조하여 사정거리를 늘렸다.", "ts": 60, "ss": 50}, "52": {"eng": "Winchester", "cat": "무기", "desc": "사정거리도 길고 크리티컬율도 높은 라이플.", "ts": 70, "ss": 60}, "53": {"eng": "S.M.G", "cat": "무기", "desc": "사정거리는 짧지만 3연사가 가능한 라이플.(3연사 사용가능)", "ts": 40, "ss": 50}, "54": {"eng": "Assault Rifle", "cat": "무기", "desc": "기관단총을 개조하여 사정거리를 늘린 라이플.(6연사 사용가능)", "ts": 60, "ss": 50}, "55": {"eng": "Machine Gun", "cat": "무기", "desc": "한번 방아쇠를 당기면 6발이 나간다. 공격력은 돌격소총보다 탁월하다.(6연사 사용가능)", "ts": 80, "ss": 60}, "56": {"eng": "Sniper Gun", "cat": "무기", "desc": "먼 거리의 적도 공격할 수 있는 라이플.", "ts": 100, "ss": 80}, "57": {"eng": "Astra", "cat": "무기", "desc": "메카닉의 회로를 한순간에 마비 시켜 버리는 라이플(쇼크웨이브 기능)"}, "58": {"eng": "Mitnal", "cat": "무기", "desc": "탄알에 독소가 묻어있어서 적을 중독시키기는 라이플(중독 기능)", "ts": 90, "ss": 80}, "59": {"eng": "Rail Gun", "cat": "무기", "desc": "최고의 사정거리를 자랑하는 라이플.", "ts": 120, "ss": 80}, "60": {"eng": "Sarnas", "cat": "무기", "desc": "투르의 기술력으로 개발된 빔을 발사하는 라이플.", "ts": 100, "ss": 80}, "61": {"eng": "Tshub", "cat": "무기", "desc": "빔의 파워를 증폭시킨 회염계의 빔 라이플로 개조 하였다.", "ts": 120, "ss": 90}, "62": {"eng": "Argon", "cat": "무기", "desc": "발사되는 빔은 육체를 그데로 녹여 버리기도 한다는 빔 라이플.(암살 기능)", "ts": 130, "ss": 100}, "63": {"eng": "Long Bow", "cat": "무기", "desc": "가장 널리퍼진 활.", "ts": 70, "ss": 60}, "64": {"eng": "Thunder Bow", "cat": "무기", "desc": "번개의 힘을 봉인한 활. (라이트닝 볼츠 추가)", "ts": 80, "ss": 70}, "65": {"eng": "Ghost Bow", "cat": "무기", "desc": "정체불명의 활 (특수능력 : 사정거리 무한대)", "ts": 100, "ss": 80}, "66": {"eng": "Lance", "cat": "무기", "desc": "가장 일반적인 창. 검에 비해서 장거리 공격이 가능하다.", "ts": 60, "ss": 60}, "67": {"eng": "Centrion", "cat": "무기", "desc": "랜스의 재질을 강화 시켜서 성능을 향상 시킨 창.", "ts": 70, "ss": 70}, "68": {"eng": "Myolnir", "cat": "무기", "desc": "귀족들을 위해 제자고디었던 고급스러운 창.", "ts": 80, "ss": 80}, "69": {"eng": "Longinus", "cat": "무기", "desc": "최고의 창으로 성스러운 힘에의해 언데드계의 몬스터들은 창에 닿는 순간 소멸해 버린다.", "ts": 100, "ss": 100}, "70": {"eng": "Fire Circlet", "cat": "써크렛", "desc": "화아어 마스터의 상징. (화이어볼 사용가능)"}, "71": {"eng": "Ice Circlet", "cat": "써크렛", "desc": "아이스 마스터의 상징 (아이스실드 사용가능)"}, "72": {"eng": "Thunder Circlet", "cat": "써크렛", "desc": "썬더 마스터의 상징. (쇽크웨이브 사용가능)"}, "73": {"eng": "Wizard Circlet", "cat": "써크렛", "desc": "최고의 마법사만이 사용할 수 있는 써크렛. (INT+20/MR+20/킬링필드 사용가능)"}, "74": {"eng": "Psychic Circlet", "cat": "써크렛", "desc": "마법사들의 정신력 소모를 보완하기 위해서 만들어진 써크렛. (소울치 추가 회복)"}, "75": {"eng": "Force Circlet", "cat": "써크렛", "desc": "사이킥 서크렛의 강화판. (소울치 추가 회복)"}, "76": {"eng": "Round Shield", "cat": "방어구", "desc": "작고 동그란 방패. (AC+5)"}, "77": {"eng": "Knight Shield", "cat": "방어구", "desc": "일반적인 기사들이 애용하는 방패. (AC+8)"}, "78": {"eng": "Tower Shield", "cat": "방어구", "desc": "자신의 몸을 전부 가릴 정도로 커다란 방패. (AC+13)"}, "79": {"eng": "Dragon Shield", "cat": "방어구", "desc": "드래곤의 비늘로 만들어진 방패. (AC+18)"}, "80": {"eng": "Magic Shield", "cat": "방어구", "desc": "마법의 힘을 가진 방패로 사용자를 마법의 힘으로 보호해 준다. (AC+17/배리어 사용가능)"}, "81": {"eng": "Isis Shield", "cat": "방어구", "desc": "현존하는 최고의 방패. 어떠한 공격으로부터 견디어 낼수 있다. (AC+20/MR+10)"}, "82": {"eng": "Lether Armor", "cat": "방어구", "desc": "여행자들이 즐겨입는 갑옷. 가볍기는 하나 방어력은 그다지 좋지 않다.(AC+10)"}, "83": {"eng": "Ring Armor", "cat": "방어구", "desc": "링을 엮어서 만든 갑옷. 약간 무거워서 움직임이 둔탁해 진다.(AC+15/DEX-5)"}, "84": {"eng": "Scale Armor", "cat": "방어구", "desc": "방어력은 쓸만하지만 무게가 무겁다.(AC+18/DEX-8)"}, "85": {"eng": "Chain Armor", "cat": "방어구", "desc": "링아머를 개량해서 화살하나 들어올 틈도 주지 않았다.(AC+23/DEX-12)"}, "86": {"eng": "Plate Armor", "cat": "방어구", "desc": "최강의 방어력을 생각한 나머지 무겁게 만들어 졌다.(AC+30/이동거리-1/DEX-16)"}, "87": {"eng": "Dragon Armor", "cat": "방어구", "desc": "용의 비늘을 겹겹으로 쌓아 만든 최강의 갑옷.(AC+35)"}, "88": {"eng": "Anti-Ammo Suite", "cat": "방어구", "desc": "방어력은 약하지만 가볍고 라이플등에 강하다.(총 데미지 약화)"}, "89": {"eng": "Anri-fire Suite", "cat": "방어구", "desc": "뜨거운 열기 속에서도 체력을 잃지 않을수 있다.(화염속성 강화)"}, "90": {"eng": "Anti-Ice Suite", "cat": "방어구", "desc": "남극 지방에서도 추위로부터 몸을 보호할 수 있다.(빙한속성 강화)"}, "91": {"eng": "Anti-eletro Suite", "cat": "방어구", "desc": "전기적인 충격으로부터 몸을 보호해 준다.(전격속성 강화)"}, "92": {"eng": "Protect Suite", "cat": "방어구", "desc": "몸의 이상상태를 막아준다.(AC+5/스테터스 이상상태 방어)"}, "93": {"eng": "Skeleton Shoes", "cat": "방어구", "desc": "뼈를 깍아만든 옷으로 최강의 방어력을 갖고 있지만...(AC+60/SPD-12/MR-30)"}, "94": {"eng": "Powered Shoes", "cat": "방어구", "desc": "근육을 압박하여 힘을 증폭시켜 주는 옷.(STR+10/DEX+10/AC+10)"}, "95": {"eng": "Mirage Shoes", "cat": "방어구", "desc": "보다 먼곳까지 마법을 사용 할수있게 해준다.(AC+5/RANGE+3)"}, "96": {"eng": "Fatima Shoes", "cat": "방어구", "desc": "파티마 연구에서 얻어진 결과로 만들어진 옷. (INT+15/MR+30/AC+5)"}, "97": {"eng": "Ruby Ring", "cat": "장신구", "desc": "뜨거운 용암속에서 숙성된 루비로 만들어진 반지(화염능력 강화)"}, "98": {"eng": "Diamond Ring", "cat": "장신구", "desc": "차가운 얼음속에서 갑자기 냉각시킨 다이아몬드로 만들어진 반지.(빙한능력 강화)"}, "99": {"eng": "Emerald Ring", "cat": "장신구", "desc": "번개로 쪼개진 에메랄드의 파편으로 만들어진 반지.(전격속성 강화)"}, "100": {"eng": "Pearl Ring", "cat": "장신구", "desc": "오염되지 않은 바다에서 얻은 진주로 만들어진 반지.(회복속성 강화)"}, "101": {"eng": "Black Pearl Ring", "cat": "장신구", "desc": "깊은 바다에서 얻은 흑진주로 만들어진 반지.(암흑속성 강화)"}, "102": {"eng": "Speed Shoes", "ca